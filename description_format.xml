<?xml version="1.0"?>
<BCPFORMAT xmlns="http://schemas.microsoft.com/sqlserver/2004/bulkload/format" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <RECORD>
    <FIELD ID="1" xsi:type="CharTerm" TERMINATOR="," MAX_LENGTH="400"/>
    <FIELD ID="2" xsi:type="CharTerm" TERMINATOR="\r\n" MAX_LENGTH="1000"/>
  </RECORD>
  <ROW>
    <COLUMN SOURCE="1" NAME="field_name" xsi:type="SQLNVARCHAR"/>
    <COLUMN SOURCE="2" NAME="field_description" xsi:type="SQLNVARCHAR"/>
  </ROW>
</BCPFORMAT>
